<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <!-- Debug: console subsystem for run.bat debugging -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <!-- Release: Windows subsystem, no console window -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="icon.png" />
  </ItemGroup>

  <!-- Copy App.html to output directory -->
  <ItemGroup>
    <None Update="App.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

</Project>
