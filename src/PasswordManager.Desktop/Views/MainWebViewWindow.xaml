<Window x:Class="PasswordManager.Desktop.Views.MainWebViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="密码管家"
        Height="720"
        Width="1180"
        MinHeight="520"
        MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/icon.png"
        Background="#F0F0F0"
        Closing="Window_Closing">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#e8e8ed" BorderThickness="0,0,0,1" Padding="12,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="更换服务器" Padding="10,4"
                        Click="ChangeServer_Click"/>
                <TextBlock x:Name="ServerLabel" VerticalAlignment="Center"
                           Foreground="#888" FontSize="12"/>
            </DockPanel>
        </Border>
        <Grid x:Name="RootGrid"/>
    </DockPanel>
</Window>
