<Window x:Class="PasswordManager.Desktop.Views.ConnectServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连接服务器"
        Height="320"
        Width="460"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/icon.png"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="密码管家" FontSize="22" FontWeight="SemiBold" Foreground="#1a1a2e"/>
        <TextBlock Grid.Row="1" Margin="0,6,0,18" Foreground="#888"
                   Text="填写服务端地址后即可登录，与 Web 端共用同一套界面。"/>

        <TextBlock Grid.Row="2" Text="服务器地址" Margin="0,0,0,6" Foreground="#555"/>
        <TextBox x:Name="UrlBox" Grid.Row="3" Padding="10,8"
                 Text="http://localhost:5173"/>

        <TextBlock x:Name="StatusText" Grid.Row="4" Margin="0,12,0,0"
                   TextWrapping="Wrap" Foreground="#888"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="测试连接" Width="96" Height="34" Margin="0,0,8,0"
                    Click="Test_Click"/>
            <Button Content="连接" Width="96" Height="34"
                    Background="#18A058" Foreground="White"
                    Click="Connect_Click"/>
        </StackPanel>
    </Grid>
</Window>
