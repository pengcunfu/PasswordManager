<Window x:Class="PasswordManager.Views.PasswordGeneratorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordManager.Views"
        mc:Ignorable="d"
        Title="密码生成器"
        Height="450"
        Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="../icon.png"
        Background="#F0F0F0">

    <Window.Resources>
        <!-- 滚动条样式 -->
        <Style x:Key="ModernScrollBar" TargetType="ScrollBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Margin="10,0,0,0">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#C0C0C0" CornerRadius="2" Margin="0,0,0,0" MinWidth="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="3"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Style.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}"/>
            </Style.Resources>
        </Style>

        <!-- 主按钮样式 -->
        <Style x:Key="NaivePrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#18A058"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要按钮样式 -->
        <Style x:Key="NaiveSecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#E0E0E6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F8F8F8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E8E8E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 输入框样式 -->
        <Style x:Key="NaiveTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#18A058"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 只读输入框样式 -->
        <Style x:Key="ReadOnlyTextBox" TargetType="TextBox" BasedOn="{StaticResource NaiveTextBox}">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>

        <!-- CheckBox 样式 -->
        <Style x:Key="NaiveCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <!-- GroupBox 样式 -->
        <Style x:Key="NaiveGroupBox" TargetType="GroupBox">
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border BorderThickness="{TemplateBinding BorderThickness}"
                               BorderBrush="{TemplateBinding BorderBrush}"
                               CornerRadius="8"
                               Background="White"
                               Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                 Text="密码生成器"
                 FontSize="18"
                 FontWeight="SemiBold"
                 Foreground="#333333"
                 Margin="0,0,0,16"/>

            <!-- 主要内容 -->
            <ScrollViewer Grid.Row="1" Style="{StaticResource ModernScrollViewer}">
                <StackPanel>
                    <!-- 密码长度 -->
                    <GroupBox Header="密码长度" Style="{StaticResource NaiveGroupBox}">
                        <StackPanel>
                            <TextBlock x:Name="LengthLabel"
                                     Text="长度: 12"
                                     FontSize="13"
                                     Foreground="#666666"
                                     Margin="0,0,0,8"/>
                            <Slider x:Name="LengthSlider"
                                  Minimum="8"
                                  Maximum="32"
                                  Value="12"
                                  IsSnapToTickEnabled="True"
                                  TickFrequency="1"
                                  ValueChanged="LengthSlider_ValueChanged"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                <TextBlock Text="8"
                                         FontSize="11"
                                         Foreground="#999999"
                                         Margin="0,0,0,0"/>
                                <TextBlock Text="32"
                                         FontSize="11"
                                         Foreground="#999999"
                                         Margin="0,0,8,0"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- 字符类型选项 -->
                    <GroupBox Header="包含字符类型" Style="{StaticResource NaiveGroupBox}">
                        <StackPanel>
                            <CheckBox x:Name="IncludeUppercaseCheckBox"
                                    Content="大写字母 (A-Z)"
                                    IsChecked="True"
                                    Style="{StaticResource NaiveCheckBox}"/>
                            <CheckBox x:Name="IncludeLowercaseCheckBox"
                                    Content="小写字母 (a-z)"
                                    IsChecked="True"
                                    Style="{StaticResource NaiveCheckBox}"/>
                            <CheckBox x:Name="IncludeDigitsCheckBox"
                                    Content="数字 (0-9)"
                                    IsChecked="True"
                                    Style="{StaticResource NaiveCheckBox}"/>
                            <CheckBox x:Name="IncludeSymbolsCheckBox"
                                    Content="特殊符号 (!@#$%^&amp;*)"
                                    IsChecked="True"
                                    Style="{StaticResource NaiveCheckBox}"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 生成按钮 -->
                    <Button x:Name="GenerateButton"
                          Content="生成密码"
                          Style="{StaticResource NaivePrimaryButton}"
                          Click="GenerateButton_Click"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,16"/>

                    <!-- 生成的密码 -->
                    <GroupBox Header="生成的密码" Style="{StaticResource NaiveGroupBox}">
                        <StackPanel>
                            <TextBox x:Name="GeneratedPasswordTextBox"
                                   Style="{StaticResource ReadOnlyTextBox}"
                                   FontSize="15"
                                   Margin="0,0,0,8"/>

                            <!-- 密码强度显示 -->
                            <TextBlock x:Name="StrengthLabel"
                                     Text="密码强度: 无"
                                     FontSize="12"
                                     Foreground="#888888"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- 按钮区域 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CopyButton"
                      Content="复制"
                      Style="{StaticResource NaiveSecondaryButton}"
                      Click="CopyButton_Click"
                      Margin="0,0,8,0"/>
                <Button x:Name="UseButton"
                      Content="使用"
                      Style="{StaticResource NaivePrimaryButton}"
                      Click="UseButton_Click"
                      Margin="0,0,8,0"/>
                <Button x:Name="CloseButton"
                      Content="关闭"
                      Style="{StaticResource NaiveSecondaryButton}"
                      Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
</Window>
