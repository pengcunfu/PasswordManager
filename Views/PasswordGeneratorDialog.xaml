<Window x:Class="PasswordManager.Views.PasswordGeneratorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordManager.Views"
        mc:Ignorable="d"
        Title="密码生成器"
        Height="420"
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="../icon.png">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                 Text="密码生成器"
                 FontSize="16"
                 FontWeight="Bold"
                 Margin="0,0,0,15"/>

        <!-- 主要内容 -->
        <StackPanel Grid.Row="1">
            <!-- 密码长度 -->
            <GroupBox Header="密码长度" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock x:Name="LengthLabel"
                             Text="长度: 12"
                             Margin="0,0,0,5"/>
                    <Slider x:Name="LengthSlider"
                          Minimum="8"
                          Maximum="32"
                          Value="12"
                          IsSnapToTickEnabled="True"
                          TickFrequency="1"
                          ValueChanged="LengthSlider_ValueChanged"/>
                </StackPanel>
            </GroupBox>

            <!-- 字符类型选项 -->
            <GroupBox Header="包含字符类型" Margin="0,0,0,10">
                <StackPanel>
                    <CheckBox x:Name="IncludeUppercaseCheckBox"
                            Content="大写字母 (A-Z)"
                            IsChecked="True"
                            Margin="0,3"/>
                    <CheckBox x:Name="IncludeLowercaseCheckBox"
                            Content="小写字母 (a-z)"
                            IsChecked="True"
                            Margin="0,3"/>
                    <CheckBox x:Name="IncludeDigitsCheckBox"
                            Content="数字 (0-9)"
                            IsChecked="True"
                            Margin="0,3"/>
                    <CheckBox x:Name="IncludeSymbolsCheckBox"
                            Content="特殊符号 (!@#$%^&amp;*)"
                            IsChecked="True"
                            Margin="0,3"/>
                </StackPanel>
            </GroupBox>

            <!-- 生成按钮 -->
            <Button x:Name="GenerateButton"
                  Content="生成密码"
                  Click="GenerateButton_Click"
                  Width="100"
                  Margin="0,0,0,10"
                  HorizontalAlignment="Center"/>

            <!-- 生成的密码 -->
            <GroupBox Header="生成的密码" Margin="0,0,0,10">
                <StackPanel>
                    <TextBox x:Name="GeneratedPasswordTextBox"
                           IsReadOnly="True"
                           FontFamily="Consolas"
                           FontSize="14"
                           Margin="0,0,0,5"/>

                    <!-- 密码强度显示 -->
                    <TextBlock x:Name="StrengthLabel"
                             Text="密码强度: 无"
                             FontSize="11"
                             Foreground="Gray"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <!-- 按钮区域 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CopyButton"
                  Content="复制"
                  Click="CopyButton_Click"
                  Width="80"
                  Margin="0,0,5,0"/>
            <Button x:Name="UseButton"
                  Content="使用"
                  Click="UseButton_Click"
                  Width="80"
                  Margin="0,0,5,0"/>
            <Button x:Name="CloseButton"
                  Content="关闭"
                  Click="CloseButton_Click"
                  Width="80"/>
        </StackPanel>
    </Grid>
</Window>
