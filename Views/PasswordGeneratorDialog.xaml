<Window x:Class="PasswordManager.Views.PasswordGeneratorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordManager.Views"
        mc:Ignorable="d"
        Title="密码生成器"
        Height="450"
        Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="../icon.png"
        Background="#F0F0F0">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/CommonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                 Text="密码生成器"
                 FontSize="18"
                 FontWeight="SemiBold"
                 Foreground="#333333"
                 Margin="0,0,0,16"/>

            <!-- 主要内容 -->
            <ScrollViewer Grid.Row="1" Style="{StaticResource ModernScrollViewer}">
                <StackPanel>
                    <!-- 密码长度 -->
                    <GroupBox Header="密码长度" Style="{StaticResource NaiveGroupBox}">
                        <StackPanel>
                            <TextBlock x:Name="LengthLabel"
                                     Text="长度: 12"
                                     FontSize="13"
                                     Foreground="#666666"
                                     Margin="0,0,0,8"/>
                            <Slider x:Name="LengthSlider"
                                  Minimum="8"
                                  Maximum="32"
                                  Value="12"
                                  IsSnapToTickEnabled="True"
                                  TickFrequency="1"
                                  ValueChanged="LengthSlider_ValueChanged"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                <TextBlock Text="8"
                                         FontSize="11"
                                         Foreground="#999999"
                                         Margin="0,0,0,0"/>
                                <TextBlock Text="32"
                                         FontSize="11"
                                         Foreground="#999999"
                                         Margin="0,0,8,0"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- 字符类型选项 -->
                    <GroupBox Header="包含字符类型" Style="{StaticResource NaiveGroupBox}">
                        <StackPanel>
                            <CheckBox x:Name="IncludeUppercaseCheckBox"
                                    Content="大写字母 (A-Z)"
                                    IsChecked="True"
                                    Style="{StaticResource NaiveCheckBox}"/>
                            <CheckBox x:Name="IncludeLowercaseCheckBox"
                                    Content="小写字母 (a-z)"
                                    IsChecked="True"
                                    Style="{StaticResource NaiveCheckBox}"/>
                            <CheckBox x:Name="IncludeDigitsCheckBox"
                                    Content="数字 (0-9)"
                                    IsChecked="True"
                                    Style="{StaticResource NaiveCheckBox}"/>
                            <CheckBox x:Name="IncludeSymbolsCheckBox"
                                    Content="特殊符号 (!@#$%^&amp;*)"
                                    IsChecked="True"
                                    Style="{StaticResource NaiveCheckBox}"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 生成按钮 -->
                    <Button x:Name="GenerateButton"
                          Content="生成密码"
                          Style="{StaticResource NaivePrimaryButton}"
                          Click="GenerateButton_Click"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,16"/>

                    <!-- 生成的密码 -->
                    <GroupBox Header="生成的密码" Style="{StaticResource NaiveGroupBox}">
                        <StackPanel>
                            <TextBox x:Name="GeneratedPasswordTextBox"
                                   Style="{StaticResource ReadOnlyTextBox}"
                                   FontSize="15"
                                   Margin="0,0,0,8"/>

                            <!-- 密码强度显示 -->
                            <TextBlock x:Name="StrengthLabel"
                                     Text="密码强度: 无"
                                     FontSize="12"
                                     Foreground="#888888"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- 按钮区域 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CopyButton"
                      Content="复制"
                      Style="{StaticResource NaiveSecondaryButton}"
                      Click="CopyButton_Click"
                      Margin="0,0,8,0"/>
                <Button x:Name="UseButton"
                      Content="使用"
                      Style="{StaticResource NaivePrimaryButton}"
                      Click="UseButton_Click"
                      Margin="0,0,8,0"/>
                <Button x:Name="CloseButton"
                      Content="关闭"
                      Style="{StaticResource NaiveSecondaryButton}"
                      Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
</Window>
