<Window x:Class="PasswordManager.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="密码管家"
        Height="380"
        Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="../icon.png"
        Background="#F0F0F0">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/CommonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题区域 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="TitleTextBlock"
                     Text="密码管家"
                     FontSize="22"
                     FontWeight="SemiBold"
                     Foreground="#333333"
                     HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- 副标题 -->
        <TextBlock x:Name="SubtitleTextBlock"
                 Grid.Row="1"
                 Text="请输入主密码解锁"
                 FontSize="13"
                 Foreground="#666666"
                 HorizontalAlignment="Center"
                 Margin="0,0,0,10"/>

            <!-- 表单区域 -->
            <StackPanel x:Name="FormPanel" Grid.Row="2">
                <!-- 主密码输入 -->
                <TextBlock Text="主密码"
                          FontSize="14"
                          Foreground="#555555"
                          Margin="0,0,0,8"/>
                <PasswordBox x:Name="PasswordBox"
                          Style="{StaticResource NaivePasswordBox}"
                          Margin="0,0,0,10"/>

                <!-- 确认密码输入（仅在首次设置时显示） -->
                <TextBlock x:Name="ConfirmPasswordLabel"
                          Text="确认密码"
                          FontSize="14"
                          Foreground="#555555"
                          Margin="0,0,0,8"
                          Visibility="Collapsed"/>
                <PasswordBox x:Name="ConfirmPasswordBox"
                          Style="{StaticResource NaivePasswordBox}"
                          Margin="0,0,0,10"
                          Visibility="Collapsed"/>

                <!-- 密码强度显示（仅在首次设置时显示） -->
                <TextBlock x:Name="StrengthLabel"
                          Text="密码强度: 无"
                          FontSize="12"
                          Foreground="#888888"
                          Margin="0,0,0,8"
                          Visibility="Collapsed"/>
            </StackPanel>

            <!-- 按钮区域 -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="CancelButton"
                      Content="退出"
                      Style="{StaticResource NaiveSecondaryButton}"
                      Margin="0,0,8,0"
                      Click="CancelButton_Click"/>
                <Button x:Name="LoginButton"
                      Content="解锁"
                      Style="{StaticResource NaivePrimaryButton}"
                      Click="LoginButton_Click"/>
            </StackPanel>
        </Grid>
</Window>
