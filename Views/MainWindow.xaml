<Window x:Class="PasswordManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordManager.Views"
        mc:Ignorable="d"
        Title="密码管家"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Icon="../icon.png">

    <Window.Resources>
        <local:FirstCharConverter x:Key="FirstCharConverter"/>
    </Window.Resources>

    <DockPanel>
        <!-- 工具栏 -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button x:Name="AddButton"
                      Content="添加密码"
                      Click="AddButton_Click"
                      Padding="10,3"/>
                <Button x:Name="GeneratePasswordButton"
                      Content="生成密码"
                      Click="GeneratePasswordButton_Click"
                      Padding="10,3"/>
                <Button x:Name="BackupButton"
                      Content="备份数据"
                      Click="BackupButton_Click"
                      Padding="10,3"/>
                <Separator/>
                <Button x:Name="LogoutButton"
                      Content="注销"
                      Click="LogoutButton_Click"
                      Padding="10,3"/>
            </ToolBar>
        </ToolBarTray>

        <!-- 主要内容区域 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧密码列表 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 搜索栏 -->
                <TextBox x:Name="SearchTextBox"
                       Grid.Row="0"
                       Margin="5"
                       TextChanged="SearchTextBox_TextChanged"/>

                <!-- 密码列表 -->
                <ListBox x:Name="EntryListBox"
                       Grid.Row="1"
                       SelectionChanged="EntryListBox_SelectionChanged"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5">
                                <TextBlock Text="{Binding Title}"
                                         FontWeight="Bold"
                                         FontSize="13"/>
                                <TextBlock Text="{Binding Username}"
                                         FontSize="11"
                                         Foreground="Gray"/>
                                <TextBlock Text="{Binding Category}"
                                         FontSize="10"
                                         Foreground="DarkGray"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- 分隔线 -->
            <GridSplitter Grid.Column="1"
                        Width="5"
                        HorizontalAlignment="Stretch"
                        Background="LightGray"/>

            <!-- 右侧详情面板 -->
            <Grid Grid.Column="2" Margin="10">
                <!-- 默认显示 -->
                <TextBlock x:Name="WelcomeText"
                         Text="选择一个密码条目查看详情"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="14"
                         Foreground="Gray"/>

                <!-- 详情内容 -->
                <ScrollViewer x:Name="DetailContent"
                            Visibility="Collapsed"
                            VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 标题 -->
                        <TextBlock x:Name="DetailTitle"
                                 FontSize="18"
                                 FontWeight="Bold"
                                 Margin="0,0,0,15"/>

                        <!-- 用户名 -->
                        <GroupBox Header="用户名" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DetailUsername"
                                       Grid.Column="0"
                                       IsReadOnly="True"
                                       Margin="0,0,5,0"/>
                                <Button x:Name="CopyUsernameButton"
                                      Grid.Column="1"
                                      Content="复制"
                                      Click="CopyUsernameButton_Click"
                                      Width="60"/>
                            </Grid>
                        </GroupBox>

                        <!-- 密码 -->
                        <GroupBox Header="密码" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DetailPassword"
                                       Grid.Column="0"
                                       IsReadOnly="True"
                                       Margin="0,0,5,0"/>
                                <Button x:Name="ShowPasswordButton"
                                      Grid.Column="1"
                                      Content="显示"
                                      Click="ShowPasswordButton_Click"
                                      Width="60"
                                      Margin="0,0,5,0"/>
                                <Button x:Name="CopyPasswordButton"
                                      Grid.Column="2"
                                      Content="复制"
                                      Click="CopyPasswordButton_Click"
                                      Width="60"/>
                            </Grid>
                        </GroupBox>

                        <!-- 网址 -->
                        <GroupBox Header="网址" Margin="0,0,0,10">
                            <TextBox x:Name="DetailURL" IsReadOnly="True"/>
                        </GroupBox>

                        <!-- 分类 -->
                        <GroupBox Header="分类" Margin="0,0,0,10">
                            <TextBox x:Name="DetailCategory" IsReadOnly="True"/>
                        </GroupBox>

                        <!-- 备注 -->
                        <GroupBox Header="备注" Margin="0,0,0,10">
                            <TextBox x:Name="DetailNotes"
                                   IsReadOnly="True"
                                   TextWrapping="Wrap"
                                   AcceptsReturn="True"
                                   Height="80"
                                   VerticalScrollBarVisibility="Auto"/>
                        </GroupBox>

                        <!-- 时间信息 -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock x:Name="DetailCreatedAt"
                                     FontSize="11"
                                     Foreground="Gray"/>
                            <TextBlock x:Name="DetailUpdatedAt"
                                     FontSize="11"
                                     Foreground="Gray"
                                     Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- 操作按钮 -->
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="EditButton"
                                  Content="编辑"
                                  Click="EditButton_Click"
                                  Width="80"
                                  Margin="0,0,10,0"/>
                            <Button x:Name="DeleteButton"
                                  Content="删除"
                                  Click="DeleteButton_Click"
                                  Width="80"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
