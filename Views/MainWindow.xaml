<Window x:Class="PasswordManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordManager.Views"
        xmlns:converters="clr-namespace:PasswordManager.Views.Converters"
        mc:Ignorable="d"
        Title="密码管家"
        Height="620"
        Width="1050"
        WindowStartupLocation="CenterScreen"
        Icon="../icon.png"
        Background="#F0F0F0">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/CommonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:FirstCharConverter x:Key="FirstCharConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top"
               Background="White"
               BorderThickness="0,0,0,1"
               BorderBrush="#E0E0E6"
               Padding="10,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AddButton"
                      Content="添加密码"
                      Style="{StaticResource ToolbarButton}"
                      Click="AddButton_Click"/>
                <Button x:Name="GeneratePasswordButton"
                      Content="生成密码"
                      Style="{StaticResource ToolbarButton}"
                      Click="GeneratePasswordButton_Click"/>
                <Button x:Name="BackupButton"
                      Content="备份数据"
                      Style="{StaticResource ToolbarButton}"
                      Click="BackupButton_Click"/>
                <Button x:Name="AiAssistantButton"
                      Content="AI 助手"
                      Style="{StaticResource ToolbarButton}"
                      Click="AiAssistantButton_Click"/>
                <Button x:Name="AboutButton"
                      Content="关于"
                      Style="{StaticResource ToolbarButton}"
                      Click="AboutButton_Click"/>
                <Button x:Name="LogoutButton"
                      Content="注销"
                      Style="{StaticResource ToolbarButton}"
                      Click="LogoutButton_Click"/>
            </StackPanel>
        </Border>

        <!-- 主要内容区域 -->
        <Grid Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧密码列表 -->
            <Border Grid.Column="0" Background="White" BorderBrush="#D0D0D0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 搜索栏 -->
                    <TextBox x:Name="SearchTextBox"
                           Grid.Row="0"
                           Style="{StaticResource SearchBox}"/>

                    <!-- 密码列表 -->
                    <ListBox x:Name="EntryListBox"
                           Grid.Row="1"
                           ItemContainerStyle="{StaticResource ListBoxItemStyle}"
                           SelectionChanged="EntryListBox_SelectionChanged"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           BorderThickness="0"
                           Background="Transparent">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}"/>
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                             Text="{Binding Title}"
                                             FontWeight="Medium"
                                             FontSize="14"
                                             Foreground="#333333"
                                             Margin="0,0,0,4"/>

                                    <TextBlock Grid.Row="1"
                                             Text="{Binding Username}"
                                             FontSize="12"
                                             Foreground="#888888"
                                             Margin="0,0,0,3"/>

                                    <Border Grid.Row="2"
                                           Background="#F0F0F2"
                                           CornerRadius="4"
                                           Padding="8,3"
                                           HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Category}"
                                                 FontSize="11"
                                                 Foreground="#666666"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 分隔线 -->
            <Grid Grid.Column="1"/>

            <!-- 右侧详情面板 -->
            <Border Grid.Column="2"
                   Background="White"
                   BorderBrush="#D0D0D0"
                   BorderThickness="1"
                   Padding="10,10,10,10">

                <Grid>
                    <!-- 默认显示 -->
                    <TextBlock x:Name="WelcomeText"
                             Text="选择一个密码条目查看详情"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             FontSize="15"
                             Foreground="#AAAAAA"/>

                    <!-- 详情内容 -->
                    <ScrollViewer x:Name="DetailContent"
                                Visibility="Collapsed"
                                Style="{StaticResource ModernScrollViewer}">
                        <StackPanel>
                            <!-- 标题 -->
                            <TextBlock x:Name="DetailTitle"
                                     FontSize="22"
                                     FontWeight="SemiBold"
                                     Foreground="#333333"
                                     Margin="0,0,0,10"/>

                            <!-- 用户名 -->
                            <GroupBox Header="用户名" Style="{StaticResource NaiveGroupBox}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DetailUsername"
                                           Grid.Column="0"
                                           Style="{StaticResource ReadOnlyTextBox}"
                                           Margin="0,0,8,0"/>
                                    <Button x:Name="CopyUsernameButton"
                                          Grid.Column="1"
                                          Content="复制"
                                          Style="{StaticResource NaiveSecondaryButton}"
                                          Click="CopyUsernameButton_Click"
                                          Width="70"/>
                                </Grid>
                            </GroupBox>

                            <!-- 密码 -->
                            <GroupBox Header="密码" Style="{StaticResource NaiveGroupBox}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DetailPassword"
                                           Grid.Column="0"
                                           Style="{StaticResource ReadOnlyTextBox}"
                                           Margin="0,0,8,0"/>
                                    <Button x:Name="ShowPasswordButton"
                                          Grid.Column="1"
                                          Content="显示"
                                          Style="{StaticResource NaiveSecondaryButton}"
                                          Click="ShowPasswordButton_Click"
                                          Width="70"
                                          Margin="0,0,8,0"/>
                                    <Button x:Name="CopyPasswordButton"
                                          Grid.Column="2"
                                          Content="复制"
                                          Style="{StaticResource NaiveSecondaryButton}"
                                          Click="CopyPasswordButton_Click"
                                          Width="70"/>
                                </Grid>
                            </GroupBox>

                            <!-- 网址 -->
                            <GroupBox Header="网址" Style="{StaticResource NaiveGroupBox}">
                                <TextBox x:Name="DetailURL"
                                       Style="{StaticResource ReadOnlyTextBox}"/>
                            </GroupBox>

                            <!-- 分类 -->
                            <GroupBox Header="分类" Style="{StaticResource NaiveGroupBox}">
                                <TextBox x:Name="DetailCategory"
                                       Style="{StaticResource ReadOnlyTextBox}"/>
                            </GroupBox>

                            <!-- 备注 -->
                            <GroupBox Header="备注" Style="{StaticResource NaiveGroupBox}">
                                <TextBox x:Name="DetailNotes"
                                       Style="{StaticResource ReadOnlyTextBox}"
                                       TextWrapping="Wrap"
                                       AcceptsReturn="True"
                                       Height="100"
                                       VerticalScrollBarVisibility="Auto"
                                       VerticalContentAlignment="Top"/>
                            </GroupBox>

                            <!-- 自定义字段 -->
                            <StackPanel x:Name="CustomFieldsDetailPanel"
                                       Margin="0,0,0,10"/>

                            <!-- 时间信息 -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock x:Name="DetailCreatedAt"
                                         FontSize="12"
                                         Foreground="#999999"
                                         Margin="0,0,0,4"/>
                                <TextBlock x:Name="DetailUpdatedAt"
                                         FontSize="12"
                                         Foreground="#999999"/>
                            </StackPanel>

                            <!-- 操作按钮 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="EditButton"
                                      Content="编辑"
                                      Style="{StaticResource NaivePrimaryButton}"
                                      Click="EditButton_Click"
                                      Width="80"
                                      Margin="0,0,8,0"/>
                                <Button x:Name="DeleteButton"
                                      Content="删除"
                                      Style="{StaticResource NaiveSecondaryButton}"
                                      Click="DeleteButton_Click"
                                      Width="80"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
