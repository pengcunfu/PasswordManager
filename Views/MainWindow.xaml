<Window x:Class="PasswordManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordManager.Views"
        mc:Ignorable="d"
        Title="密码管家"
        Height="620"
        Width="1050"
        WindowStartupLocation="CenterScreen"
        Icon="../icon.png"
        Background="#F0F0F0">

    <Window.Resources>
        <local:FirstCharConverter x:Key="FirstCharConverter"/>

        <!-- 滚动条样式 -->
        <Style x:Key="ModernScrollBar" TargetType="ScrollBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Margin="10,0,0,0">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#C0C0C0" CornerRadius="2" Margin="0,0,0,0" MinWidth="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="3"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Style.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}"/>
            </Style.Resources>
        </Style>

        <!-- 主按钮样式 -->
        <Style x:Key="NaivePrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#18A058"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要按钮样式 -->
        <Style x:Key="NaiveSecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#E0E0E6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F8F8F8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E8E8E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 工具栏按钮样式 -->
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource NaiveSecondaryButton}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- 输入框样式 -->
        <Style x:Key="NaiveTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#18A058"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 只读输入框样式 -->
        <Style x:Key="ReadOnlyTextBox" TargetType="TextBox" BasedOn="{StaticResource NaiveTextBox}">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#E0E0E6"/>
        </Style>

        <!-- 列表项样式 -->
        <Style x:Key="ListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F0F0F2"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E8F5E9"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#18A058"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 搜索框样式 -->
        <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource NaiveTextBox}">
            <Setter Property="Margin" Value="12,8,12,8"/>
        </Style>

        <!-- GroupBox 样式 -->
        <Style x:Key="NaiveGroupBox" TargetType="GroupBox">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <StackPanel>
                            <TextBlock Text="{TemplateBinding Header}"
                                     FontSize="13"
                                     FontWeight="Medium"
                                     Foreground="#555555"
                                     Margin="0,0,0,8"/>
                            <ContentPresenter Margin="0,8,0,0"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top"
               Background="White"
               BorderThickness="0,0,0,1"
               BorderBrush="#E0E0E6"
               Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AddButton"
                      Content="添加密码"
                      Style="{StaticResource ToolbarButton}"
                      Click="AddButton_Click"/>
                <Button x:Name="GeneratePasswordButton"
                      Content="生成密码"
                      Style="{StaticResource ToolbarButton}"
                      Click="GeneratePasswordButton_Click"/>
                <Button x:Name="BackupButton"
                      Content="备份数据"
                      Style="{StaticResource ToolbarButton}"
                      Click="BackupButton_Click"/>
                <Button x:Name="LogoutButton"
                      Content="注销"
                      Style="{StaticResource ToolbarButton}"
                      Click="LogoutButton_Click"/>
            </StackPanel>
        </Border>

        <!-- 主要内容区域 -->
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧密码列表 -->
            <Border Grid.Column="0" Background="White" BorderBrush="#D0D0D0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 搜索栏 -->
                    <TextBox x:Name="SearchTextBox"
                           Grid.Row="0"
                           Style="{StaticResource SearchBox}"/>

                    <!-- 密码列表 -->
                    <ListBox x:Name="EntryListBox"
                           Grid.Row="1"
                           ItemContainerStyle="{StaticResource ListBoxItemStyle}"
                           SelectionChanged="EntryListBox_SelectionChanged"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           BorderThickness="0"
                           Background="Transparent">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}"/>
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                             Text="{Binding Title}"
                                             FontWeight="Medium"
                                             FontSize="14"
                                             Foreground="#333333"
                                             Margin="0,0,0,4"/>

                                    <TextBlock Grid.Row="1"
                                             Text="{Binding Username}"
                                             FontSize="12"
                                             Foreground="#888888"
                                             Margin="0,0,0,3"/>

                                    <Border Grid.Row="2"
                                           Background="#F0F0F2"
                                           CornerRadius="4"
                                           Padding="8,3"
                                           HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Category}"
                                                 FontSize="11"
                                                 Foreground="#666666"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 分隔线 -->
            <Grid Grid.Column="1"/>

            <!-- 右侧详情面板 -->
            <Border Grid.Column="2"
                   Background="White"
                   BorderBrush="#D0D0D0"
                   BorderThickness="1"
                   Padding="20">

                <Grid>
                    <!-- 默认显示 -->
                    <TextBlock x:Name="WelcomeText"
                             Text="选择一个密码条目查看详情"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             FontSize="15"
                             Foreground="#AAAAAA"/>

                    <!-- 详情内容 -->
                    <ScrollViewer x:Name="DetailContent"
                                Visibility="Collapsed"
                                Style="{StaticResource ModernScrollViewer}">
                        <StackPanel>
                            <!-- 标题 -->
                            <TextBlock x:Name="DetailTitle"
                                     FontSize="22"
                                     FontWeight="SemiBold"
                                     Foreground="#333333"
                                     Margin="0,0,0,24"/>

                            <!-- 用户名 -->
                            <GroupBox Header="用户名" Style="{StaticResource NaiveGroupBox}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DetailUsername"
                                           Grid.Column="0"
                                           Style="{StaticResource ReadOnlyTextBox}"
                                           Margin="0,0,8,0"/>
                                    <Button x:Name="CopyUsernameButton"
                                          Grid.Column="1"
                                          Content="复制"
                                          Style="{StaticResource NaiveSecondaryButton}"
                                          Click="CopyUsernameButton_Click"
                                          Width="70"/>
                                </Grid>
                            </GroupBox>

                            <!-- 密码 -->
                            <GroupBox Header="密码" Style="{StaticResource NaiveGroupBox}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DetailPassword"
                                           Grid.Column="0"
                                           Style="{StaticResource ReadOnlyTextBox}"
                                           Margin="0,0,8,0"/>
                                    <Button x:Name="ShowPasswordButton"
                                          Grid.Column="1"
                                          Content="显示"
                                          Style="{StaticResource NaiveSecondaryButton}"
                                          Click="ShowPasswordButton_Click"
                                          Width="70"
                                          Margin="0,0,8,0"/>
                                    <Button x:Name="CopyPasswordButton"
                                          Grid.Column="2"
                                          Content="复制"
                                          Style="{StaticResource NaiveSecondaryButton}"
                                          Click="CopyPasswordButton_Click"
                                          Width="70"/>
                                </Grid>
                            </GroupBox>

                            <!-- 网址 -->
                            <GroupBox Header="网址" Style="{StaticResource NaiveGroupBox}">
                                <TextBox x:Name="DetailURL"
                                       Style="{StaticResource ReadOnlyTextBox}"/>
                            </GroupBox>

                            <!-- 分类 -->
                            <GroupBox Header="分类" Style="{StaticResource NaiveGroupBox}">
                                <TextBox x:Name="DetailCategory"
                                       Style="{StaticResource ReadOnlyTextBox}"/>
                            </GroupBox>

                            <!-- 备注 -->
                            <GroupBox Header="备注" Style="{StaticResource NaiveGroupBox}">
                                <TextBox x:Name="DetailNotes"
                                       Style="{StaticResource ReadOnlyTextBox}"
                                       TextWrapping="Wrap"
                                       AcceptsReturn="True"
                                       Height="100"
                                       VerticalScrollBarVisibility="Auto"
                                       VerticalContentAlignment="Top"/>
                            </GroupBox>

                            <!-- 时间信息 -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock x:Name="DetailCreatedAt"
                                         FontSize="12"
                                         Foreground="#999999"
                                         Margin="0,0,0,4"/>
                                <TextBlock x:Name="DetailUpdatedAt"
                                         FontSize="12"
                                         Foreground="#999999"/>
                            </StackPanel>

                            <!-- 操作按钮 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="EditButton"
                                      Content="编辑"
                                      Style="{StaticResource NaivePrimaryButton}"
                                      Click="EditButton_Click"
                                      Width="80"
                                      Margin="0,0,12,0"/>
                                <Button x:Name="DeleteButton"
                                      Content="删除"
                                      Style="{StaticResource NaiveSecondaryButton}"
                                      Click="DeleteButton_Click"
                                      Width="80"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
