<Window x:Class="PasswordManager.Views.AiChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AI 助手 - 密码管家"
        Height="640"
        Width="560"
        WindowStartupLocation="CenterOwner"
        Icon="../icon.png"
        Background="#F0F0F0"
        Closing="Window_Closing">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/CommonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0"
               Background="White"
               BorderThickness="0,0,0,1"
               BorderBrush="#E0E0E6"
               Padding="12,8">
            <DockPanel>
                <TextBlock Text="AI 助手"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Foreground="#333333"
                         VerticalAlignment="Center"
                         DockPanel.Dock="Left"/>

                <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="Right"
                          DockPanel.Dock="Right">
                    <Button x:Name="SettingsButton"
                          Style="{StaticResource ToolbarButton}"
                          Click="SettingsButton_Click"
                          Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 00.12-.61l-1.92-3.32a.49.49 0 00-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 00-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.07.62-.07.94s.02.64.07.94l-2.03 1.58a.49.49 0 00-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                                  Fill="#666" Width="14" Height="14" Stretch="Uniform" Margin="0,0,4,0"/>
                            <TextBlock Text="设置"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ClearButton"
                          Style="{StaticResource ToolbarButton}"
                          Click="ClearButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                  Fill="#666" Width="14" Height="14" Stretch="Uniform" Margin="0,0,4,0"/>
                            <TextBlock Text="清空"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- WebView2 容器（程序动态创建） -->
        <Border x:Name="WebViewContainer"
               Grid.Row="1"
               Background="#F5F5F5"/>

        <!-- 底部输入区域 -->
        <Border Grid.Row="2"
               Background="White"
               BorderThickness="0,1,0,0"
               BorderBrush="#E0E0E6"
               Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="InputTextBox"
                       Grid.Column="0"
                       Style="{StaticResource NaiveTextBox}"
                       Height="40"
                       VerticalContentAlignment="Center"
                       AcceptsReturn="False"
                       KeyDown="InputTextBox_KeyDown"
                       Margin="0,0,10,0"/>

                <Button x:Name="SendButton"
                      Grid.Column="1"
                      Content="发 送"
                      Style="{StaticResource NaivePrimaryButton}"
                      Click="SendButton_Click"
                      Width="80"
                      Height="40"/>
            </Grid>
        </Border>
    </Grid>
</Window>
