<Window x:Class="PasswordManager.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="关于"
        Height="320"
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="../icon.png"
        Background="#F0F0F0">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/CommonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
            <Image Source="../icon.png"
                   Width="64"
                   Height="64"
                   Margin="0,0,0,12"/>
            <TextBlock Text="密码管家"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#333333"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="VersionText"
                       FontSize="13"
                       Foreground="#888888"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="#666666"
                       LineHeight="22"
                       Margin="0,0,0,8">
                <Run Text="本地密码管理工具，使用 AES-256 加密保护您的数据。"/>
            </TextBlock>
            <TextBlock Text="作者: HUAQI"
                       FontSize="12"
                       Foreground="#999999"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>
            <TextBlock Text="版权所有，未经许可，不得传播！"
                       FontSize="11"
                       Foreground="#AAAAAA"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Button Grid.Row="2"
                Content="确定"
                Style="{StaticResource NaivePrimaryButton}"
                Click="CloseButton_Click"
                HorizontalAlignment="Center"
                Width="100"
                Margin="0,16,0,0"/>
    </Grid>
</Window>
