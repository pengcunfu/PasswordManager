<Window x:Class="PasswordManager.Views.AddEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordManager.Views"
        mc:Ignorable="d"
        Title="添加密码"
        Height="550"
        Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="../icon.png">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock x:Name="DialogTitle"
                 Grid.Row="0"
                 Text="添加新密码"
                 FontSize="16"
                 FontWeight="Bold"
                 Margin="0,0,0,10"/>

        <!-- 表单区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 标题 -->
                <Label Content="标题 *" FontWeight="Bold"/>
                <TextBox x:Name="TitleTextBox" Margin="0,0,0,10"/>

                <!-- 用户名 -->
                <Label Content="用户名 *" FontWeight="Bold"/>
                <TextBox x:Name="UsernameTextBox" Margin="0,0,0,10"/>

                <!-- 密码 -->
                <Label Content="密码 *" FontWeight="Bold"/>
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="PasswordTextBox"
                           Grid.Column="0"
                           Visibility="Collapsed"
                           Margin="0,0,5,0"
                           TextChanged="PasswordTextBox_TextChanged"/>
                    <PasswordBox x:Name="PasswordBox"
                               Grid.Column="0"
                               Margin="0,0,5,0"
                               PasswordChanged="PasswordBox_PasswordChanged"/>

                    <Button x:Name="ShowPasswordButton"
                          Grid.Column="1"
                          Content="显示"
                          Click="ShowPasswordButton_Click"
                          Width="60"
                          Margin="0,0,5,0"/>
                    <Button x:Name="GeneratePasswordButton"
                          Grid.Column="2"
                          Content="生成"
                          Click="GeneratePasswordButton_Click"
                          Width="60"/>
                </Grid>

                <!-- 密码强度显示 -->
                <TextBlock x:Name="StrengthLabel"
                         Text="密码强度: 无"
                         FontSize="11"
                         Foreground="Gray"
                         Margin="0,0,0,10"/>

                <!-- 网址 -->
                <Label Content="网址" FontWeight="Bold"/>
                <TextBox x:Name="URLTextBox" Margin="0,0,0,10"/>

                <!-- 分类 -->
                <Label Content="分类" FontWeight="Bold"/>
                <TextBox x:Name="CategoryTextBox" Margin="0,0,0,10"/>

                <!-- 备注 -->
                <Label Content="备注" FontWeight="Bold"/>
                <TextBox x:Name="NotesTextBox"
                       TextWrapping="Wrap"
                       AcceptsReturn="True"
                       Height="80"
                       VerticalScrollBarVisibility="Auto"
                       Margin="0,0,0,10"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CancelButton"
                  Content="取消"
                  Click="CancelButton_Click"
                  Width="80"
                  Margin="0,0,10,0"/>
            <Button x:Name="SaveButton"
                  Content="保存"
                  Click="SaveButton_Click"
                  Width="80"
                  IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
