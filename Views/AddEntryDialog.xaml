<Window x:Class="PasswordManager.Views.AddEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordManager.Views"
        mc:Ignorable="d"
        Title="添加密码"
        Height="540"
        Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="../icon.png"
        Background="#F0F0F0">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/CommonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock x:Name="DialogTitle"
                 Grid.Row="0"
                 Text="添加新密码"
                 FontSize="18"
                 FontWeight="SemiBold"
                 Foreground="#333333"
                 Margin="0,0,0,10"/>

            <!-- 表单区域 -->
            <ScrollViewer Grid.Row="1" Style="{StaticResource ModernScrollViewer}">
                <StackPanel>
                    <!-- 标题 -->
                    <TextBlock Text="标题 *"
                              FontSize="13"
                              Foreground="#555555"
                              Margin="0,0,0,8"/>
                    <TextBox x:Name="TitleTextBox"
                           Style="{StaticResource NaiveTextBox}"
                           Margin="0,0,0,10"/>

                    <!-- 用户名 -->
                    <TextBlock Text="用户名 *"
                              FontSize="13"
                              Foreground="#555555"
                              Margin="0,0,0,8"/>
                    <TextBox x:Name="UsernameTextBox"
                           Style="{StaticResource NaiveTextBox}"
                           Margin="0,0,0,10"/>

                    <!-- 密码 -->
                    <TextBlock Text="密码 *"
                              FontSize="13"
                              Foreground="#555555"
                              Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="PasswordTextBox"
                               Grid.Column="0"
                               Style="{StaticResource NaiveTextBox}"
                               Visibility="Collapsed"
                               Margin="0,0,8,0"
                               TextChanged="PasswordTextBox_TextChanged"/>
                        <PasswordBox x:Name="PasswordBox"
                                   Grid.Column="0"
                                   Style="{StaticResource NaivePasswordBox}"
                                   Margin="0,0,8,0"
                                   PasswordChanged="PasswordBox_PasswordChanged"/>

                        <Button x:Name="ShowPasswordButton"
                              Grid.Column="1"
                              Content="显示"
                              Style="{StaticResource SmallButton}"
                              Click="ShowPasswordButton_Click"
                              Width="65"
                              Margin="0,0,8,0"/>
                        <Button x:Name="GeneratePasswordButton"
                              Grid.Column="2"
                              Content="生成"
                              Style="{StaticResource SmallButton}"
                              Click="GeneratePasswordButton_Click"
                              Width="65"/>
                    </Grid>

                    <!-- 密码强度显示 -->
                    <TextBlock x:Name="StrengthLabel"
                             Text="密码强度: 无"
                             FontSize="12"
                             Foreground="#888888"
                             Margin="0,0,0,10"/>

                    <!-- 网址 -->
                    <TextBlock Text="网址"
                              FontSize="13"
                              Foreground="#555555"
                              Margin="0,0,0,8"/>
                    <TextBox x:Name="URLTextBox"
                           Style="{StaticResource NaiveTextBox}"
                           Margin="0,0,0,10"/>

                    <!-- 分类 -->
                    <TextBlock Text="分类"
                              FontSize="13"
                              Foreground="#555555"
                              Margin="0,0,0,8"/>
                    <TextBox x:Name="CategoryTextBox"
                           Style="{StaticResource NaiveTextBox}"
                           Margin="0,0,0,10"/>

                    <!-- 备注 -->
                    <TextBlock Text="备注"
                              FontSize="13"
                              Foreground="#555555"
                              Margin="0,0,0,8"/>
                    <TextBox x:Name="NotesTextBox"
                           Style="{StaticResource NaiveTextBox}"
                           TextWrapping="Wrap"
                           AcceptsReturn="True"
                           Height="90"
                           VerticalScrollBarVisibility="Auto"
                           VerticalContentAlignment="Top"
                           Padding="10,8"/>
                </StackPanel>
            </ScrollViewer>

            <!-- 按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="CancelButton"
                      Content="取消"
                      Style="{StaticResource NaiveSecondaryButton}"
                      Click="CancelButton_Click"
                      Margin="0,0,8,0"/>
                <Button x:Name="SaveButton"
                      Content="保存"
                      Style="{StaticResource NaivePrimaryButton}"
                      Click="SaveButton_Click"
                      IsDefault="True"/>
            </StackPanel>
        </Grid>
</Window>
