<Window x:Class="PasswordManager.Views.AiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AI 设置"
        Height="420"
        Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="../icon.png"
        Background="#F0F0F0">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/CommonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                 Text="AI 模型配置"
                 FontSize="18"
                 FontWeight="SemiBold"
                 Foreground="#333333"
                 Margin="0,0,0,16"/>

        <!-- 表单区域 -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource ModernScrollViewer}">
            <StackPanel>
                <!-- API 地址 -->
                <TextBlock Text="API 地址"
                          FontSize="13"
                          Foreground="#555555"
                          Margin="0,0,0,6"/>
                <TextBox x:Name="ApiEndpointTextBox"
                       Style="{StaticResource NaiveTextBox}"
                       Margin="0,0,0,12"/>

                <!-- API 密钥 -->
                <TextBlock Text="API 密钥"
                          FontSize="13"
                          Foreground="#555555"
                          Margin="0,0,0,6"/>
                <PasswordBox x:Name="ApiKeyPasswordBox"
                           Style="{StaticResource NaivePasswordBox}"
                           Margin="0,0,0,12"/>

                <!-- 模型名称 -->
                <TextBlock Text="模型名称"
                          FontSize="13"
                          Foreground="#555555"
                          Margin="0,0,0,6"/>
                <TextBox x:Name="ModelTextBox"
                       Style="{StaticResource NaiveTextBox}"
                       Margin="0,0,0,12"/>

                <!-- 最大 Token 数 -->
                <TextBlock Text="最大 Token 数"
                          FontSize="13"
                          Foreground="#555555"
                          Margin="0,0,0,6"/>
                <TextBox x:Name="MaxTokensTextBox"
                       Style="{StaticResource NaiveTextBox}"
                       Margin="0,0,0,12"/>

                <!-- 温度 -->
                <TextBlock Text="温度 (0.0 - 2.0)"
                          FontSize="13"
                          Foreground="#555555"
                          Margin="0,0,0,6"/>
                <TextBox x:Name="TemperatureTextBox"
                       Style="{StaticResource NaiveTextBox}"
                       Margin="0,0,0,12"/>

                <!-- 状态提示 -->
                <TextBlock x:Name="StatusText"
                         FontSize="12"
                         Foreground="#888888"
                         TextWrapping="Wrap"
                         Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="TestButton"
                  Content="测试连接"
                  Style="{StaticResource NaiveSecondaryButton}"
                  Click="TestButton_Click"
                  Width="90"
                  Margin="0,0,8,0"/>
            <Button x:Name="CancelButton"
                  Content="取消"
                  Style="{StaticResource NaiveSecondaryButton}"
                  Click="CancelButton_Click"
                  Width="80"
                  Margin="0,0,8,0"/>
            <Button x:Name="SaveButton"
                  Content="保存"
                  Style="{StaticResource NaivePrimaryButton}"
                  Click="SaveButton_Click"
                  Width="80"/>
        </StackPanel>
    </Grid>
</Window>
